# Local overrides for docker-compose.yml
# This machine (Apple Silicon) has a native arm64 hydra-node build; the
# upstream ghcr.io image is amd64-only and its embedded etcd crashes under
# emulation. Delete this file on amd64 hosts.
HYDRA_IMAGE=local/hydra-node:2.1.0
HYDRA_WS_PORT=14001
HYDRA_HTTP_PORT=14002
